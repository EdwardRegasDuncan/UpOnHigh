[sub_resource type="GDScript" id="GDScript_6ishy"]
script/source = "extends Gun_Class
var isFiring = false
var time_since_last_shot = 0
func _ready():
	firing_interval = 0.1
	interactible = false
	magazine_size = 30
	machinegunActive = true
	ammoCount = 30
	maxAmmo = 30
func _physics_process(delta):
	if isFiring:
		time_since_last_shot += delta #replace with timer
		if time_since_last_shot >= firing_interval:
			_fire()
			time_since_last_shot = 0

func _input(event):
	if event.is_action_pressed(\"shoot\"):
		isFiring = true
	elif event.is_action_released(\"shoot\"):
		isFiring = false
	if event.is_action_pressed(\"reload\"):
		$ReloadTimer.start()
		$AnimationPlayer.play(\"Reload\")
func _fire():
	if machinegunActive == true and ammoCount > 0:
		var firing_effect_instance : GPUParticles3D = firing_vfx.instantiate()
		firing_effect_instance.global_transform = $MeshInstance3D/GunBarrel.global_transform
		firing_effect_instance.scale = Vector3(1, 1, 1)
		firing_effect_instance.emitting = true
		var new_bullet = bullet.instantiate()
		new_bullet.global_transform = $MeshInstance3D/GunBarrel.global_transform
		new_bullet.scale = Vector3(1, 1, 1)
		var scene_root = get_tree().get_root().get_children()[0]
		scene_root.add_child(new_bullet)
		scene_root.add_child(firing_effect_instance)
		ammoCount -= 1
		print(\"firing\")
		$AnimationPlayer.play(\"Recoil\")
	elif ammoCount == 0:
		$ReloadTimer.start()
		$AnimationPlayer.play(\"Reload\")


func _interact():
	pass

func _on_area_3d_area_entered(area):
	if Input.is_action_pressed(\"interact\"):
		print(\"equipped\")

func _on_reload_timer_timeout():
	_reload()
"

